# Copy to .env and fill in. Never commit .env.
# Matterport Model API: HTTP Basic, token id as username, token secret as password (server-side only)
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
# Matterport SDK key: public by design (sent as applicationKey in the viewer URL), domain-restricted
NEXT_PUBLIC_MATTERPORT_SDK_KEY=
MATTERPORT_SDK_DOMAINS=
# Vexcel API 2.0 long-life key, sent in the X-API-KEY header (server-side only)
VEXCEL_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
AGENT_MODEL=
DEMO_MODE=
ALLOWED_RECIPIENTS=
