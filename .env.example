# Copy to .env and fill in. Never commit .env. Values below are non-secret defaults; keys stay empty.
# Matterport Model API: HTTP Basic, token id as username, token secret as password.
# Admin rights over the account: server-side only, read-only queries only.
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
# Matterport SDK key: public by design (sent as applicationKey in the viewer URL), domain-restricted
NEXT_PUBLIC_MATTERPORT_SDK_KEY=
MATTERPORT_SDK_DOMAINS=
# Vexcel API 2.0 long-life key, sent in the X-API-KEY header (server-side only)
VEXCEL_API_KEY=
# Gemini: key sent only in the x-goog-api-key header. Model chosen 2026-11-14 from the models list:
# newest stable Flash that accepts images. Fallbacks are used only on 503/timeout.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=
# Hard spend limit for Gemini calls (vision + agent), in USD; see data/cache/spend.json
GEMINI_BUDGET_USD=8
# Warn once when total Gemini spend passes this, in USD
GEMINI_WARN_USD=6
# deepagents model string, provider:model format (LangChain docs); runs on Gemini
AGENT_MODEL=google_genai:gemini-3.6-flash
# Cheaper model for the six sub-agents (orchestrator keeps AGENT_MODEL)
AGENT_SUBAGENT_MODEL=google_genai:gemini-3.5-flash-lite
# Optional
ANTHROPIC_API_KEY=
DEMO_MODE=0
ALLOWED_RECIPIENTS=

# Email for the approved playbook (backend/app/actions/send.py). Leave empty for "draft only, not sent".
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
