{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "waterline/contracts/triage.schema.json",
  "title": "Triage",
  "description": "GET /triage?depth_ft=1|2|4|6: every building ranked by median total loss at that depth (v1.3; was the high end), each labelled 'surveyed' or 'structure only' so the map ranking says what it compares.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "building_id",
      "rank",
      "status",
      "positions_read",
      "scan_positions",
      "contents_assets",
      "note",
      "loss_by_depth_ft"
    ],
    "properties": {
      "building_id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "rank": {
        "type": "integer",
        "minimum": 1
      },
      "status": {
        "type": "string",
        "enum": [
          "surveyed",
          "structure only"
        ],
        "description": "structure only = no interior survey yet; its loss is the structure curve alone and is not comparable with surveyed buildings."
      },
      "positions_read": {
        "type": "integer",
        "minimum": 0,
        "description": "Scan positions the stored interior survey has read. The stored survey never shrinks: agent runs add to it. Show as \"N of M positions read\" with scan_positions."
      },
      "scan_positions": {
        "type": "integer",
        "minimum": 0,
        "description": "Scan positions (panoramas) in the Matterport model."
      },
      "contents_assets": {
        "type": "integer",
        "minimum": 0,
        "description": "Surveyed contents assets: not building fabric (A-FIN) and not road vehicles (V-VEHICLE, movable, not in contents loss). The same count the agent reports."
      },
      "note": {
        "type": "string"
      },
      "loss_by_depth_ft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "1",
          "2",
          "4",
          "6"
        ],
        "properties": {
          "1": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contents",
              "structure",
              "total",
              "contents_median",
              "structure_median",
              "total_median"
            ],
            "properties": {
              "contents": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "[low, high] in USD: the 80% interval (10th and 90th percentile of the simulation, v1.3)."
              },
              "structure": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "[low, high] in USD: the 80% interval (10th and 90th percentile of the simulation, v1.3)."
              },
              "total": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "[low, high] in USD: the 80% interval (10th and 90th percentile of the simulation, v1.3)."
              },
              "contents_median": {
                "type": "number",
                "minimum": 0,
                "description": "Contents loss, median of the simulation (v1.3)."
              },
              "structure_median": {
                "type": "number",
                "minimum": 0,
                "description": "Structure loss, median of the simulation (v1.3)."
              },
              "total_median": {
                "type": "number",
                "minimum": 0,
                "description": "Total loss, median of the simulation (v1.3)."
              }
            }
          },
          "2": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contents",
              "structure",
              "total",
              "contents_median",
              "structure_median",
              "total_median"
            ],
            "properties": {
              "contents": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "[low, high] in USD: the 80% interval (10th and 90th percentile of the simulation, v1.3)."
              },
              "structure": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "[low, high] in USD: the 80% interval (10th and 90th percentile of the simulation, v1.3)."
              },
              "total": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "[low, high] in USD: the 80% interval (10th and 90th percentile of the simulation, v1.3)."
              },
              "contents_median": {
                "type": "number",
                "minimum": 0,
                "description": "Contents loss, median of the simulation (v1.3)."
              },
              "structure_median": {
                "type": "number",
                "minimum": 0,
                "description": "Structure loss, median of the simulation (v1.3)."
              },
              "total_median": {
                "type": "number",
                "minimum": 0,
                "description": "Total loss, median of the simulation (v1.3)."
              }
            }
          },
          "4": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contents",
              "structure",
              "total",
              "contents_median",
              "structure_median",
              "total_median"
            ],
            "properties": {
              "contents": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "[low, high] in USD: the 80% interval (10th and 90th percentile of the simulation, v1.3)."
              },
              "structure": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "[low, high] in USD: the 80% interval (10th and 90th percentile of the simulation, v1.3)."
              },
              "total": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "[low, high] in USD: the 80% interval (10th and 90th percentile of the simulation, v1.3)."
              },
              "contents_median": {
                "type": "number",
                "minimum": 0,
                "description": "Contents loss, median of the simulation (v1.3)."
              },
              "structure_median": {
                "type": "number",
                "minimum": 0,
                "description": "Structure loss, median of the simulation (v1.3)."
              },
              "total_median": {
                "type": "number",
                "minimum": 0,
                "description": "Total loss, median of the simulation (v1.3)."
              }
            }
          },
          "6": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contents",
              "structure",
              "total",
              "contents_median",
              "structure_median",
              "total_median"
            ],
            "properties": {
              "contents": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "[low, high] in USD: the 80% interval (10th and 90th percentile of the simulation, v1.3)."
              },
              "structure": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "[low, high] in USD: the 80% interval (10th and 90th percentile of the simulation, v1.3)."
              },
              "total": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "[low, high] in USD: the 80% interval (10th and 90th percentile of the simulation, v1.3)."
              },
              "contents_median": {
                "type": "number",
                "minimum": 0,
                "description": "Contents loss, median of the simulation (v1.3)."
              },
              "structure_median": {
                "type": "number",
                "minimum": 0,
                "description": "Structure loss, median of the simulation (v1.3)."
              },
              "total_median": {
                "type": "number",
                "minimum": 0,
                "description": "Total loss, median of the simulation (v1.3)."
              }
            }
          }
        }
      }
    }
  }
}
