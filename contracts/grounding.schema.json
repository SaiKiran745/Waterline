{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "waterline/contracts/grounding.schema.json",
  "title": "Grounding",
  "description": "GET /buildings/{id}/grounding (contracts v1.3): ties the slider's water depth to real elevations. Waterline does not model rainfall, drainage or flow. All elevations are feet NAVD 88 (datum.match says whether FEMA and USGS agree). Each slider step's outside water surface = floor elevation + depth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "building_id",
    "computed_at",
    "method",
    "datum",
    "ground",
    "entry_points",
    "first_door",
    "floor",
    "fema_1pct",
    "reference_levels",
    "steps",
    "assumptions"
  ],
  "properties": {
    "building_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "computed_at": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "description": "Two sentences: the method, for the UI and documents."
    },
    "datum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "units",
        "usgs",
        "fema",
        "match",
        "sources",
        "note"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "units": {
          "type": "string"
        },
        "usgs": {
          "type": "string"
        },
        "fema": {
          "type": "string"
        },
        "match": {
          "type": "boolean",
          "description": "true when FEMA's V_DATUM is NAVD88 on every line used, the same datum as USGS 3DEP. When false, no FEMA level is placed on the floor scale."
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "ground": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "accuracy_rmse_ft",
        "points",
        "lowest_adjacent_ft",
        "highest_adjacent_ft",
        "low_side",
        "high_side",
        "sides",
        "around_min_ft",
        "around_max_ft",
        "sentence"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "accuracy_rmse_ft": {
          "type": "number",
          "description": "USGS EPQS overall RMSE, 0.53 m."
        },
        "points": {
          "type": "integer"
        },
        "lowest_adjacent_ft": {
          "type": [
            "number",
            "null"
          ]
        },
        "highest_adjacent_ft": {
          "type": [
            "number",
            "null"
          ]
        },
        "low_side": {
          "type": [
            "string",
            "null"
          ]
        },
        "high_side": {
          "type": [
            "string",
            "null"
          ]
        },
        "sides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "side",
              "points",
              "min_ft",
              "mean_ft",
              "max_ft"
            ],
            "properties": {
              "side": {
                "type": "string",
                "enum": [
                  "north",
                  "east",
                  "south",
                  "west"
                ]
              },
              "points": {
                "type": "integer"
              },
              "min_ft": {
                "type": "number"
              },
              "mean_ft": {
                "type": "number"
              },
              "max_ft": {
                "type": "number"
              }
            }
          }
        },
        "around_min_ft": {
          "type": [
            "number",
            "null"
          ]
        },
        "around_max_ft": {
          "type": [
            "number",
            "null"
          ]
        },
        "sentence": {
          "type": "string"
        }
      }
    },
    "entry_points": {
      "type": "array",
      "description": "Mapped entry points ranked by the ground in front of them, lowest first (water reaches rank 1 first). Joins EntryPoint.id.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_point_id",
          "kind",
          "side",
          "ground_ft",
          "rank",
          "above_lowest_door_ft"
        ],
        "properties": {
          "entry_point_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "side": {
            "type": "string"
          },
          "ground_ft": {
            "type": "number"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "above_lowest_door_ft": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "first_door": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_point_id",
        "lead_ft",
        "sentence"
      ],
      "properties": {
        "entry_point_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "lead_ft": {
          "type": [
            "number",
            "null"
          ]
        },
        "sentence": {
          "type": "string"
        }
      }
    },
    "floor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elevation_ft",
        "elevation_ft_low",
        "elevation_ft_high",
        "ground_ft",
        "allowance_id",
        "allowance_ft",
        "basis",
        "chosen_because"
      ],
      "properties": {
        "elevation_ft": {
          "type": "number",
          "description": "Estimated finished floor elevation, ft NAVD 88 (central)."
        },
        "elevation_ft_low": {
          "type": "number",
          "description": "Includes the slab allowance range, the spread of the governing ground and 1 RMSE of the USGS ground."
        },
        "elevation_ft_high": {
          "type": "number"
        },
        "ground_ft": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "allowance_id": {
          "type": "string",
          "enum": [
            "G-SLAB-GRADE",
            "G-SLAB-DOCK",
            "G-SLAB-STEP"
          ]
        },
        "allowance_ft": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "basis": {
          "type": "string"
        },
        "chosen_because": {
          "type": "string"
        }
      }
    },
    "fema_1pct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "found"
      ],
      "description": "FEMA's 1% annual-chance water-surface elevation at or nearest the building, from the NFHL's own fields (layer 14 WSEL_REG; layer 16 ELEV as a check). found=false when nothing lies within search_radius_m; then only found and search_radius_m are present.",
      "properties": {
        "found": {
          "type": "boolean"
        },
        "elevation_ft": {
          "type": "number"
        },
        "elevation_ft_low": {
          "type": "number"
        },
        "elevation_ft_high": {
          "type": "number"
        },
        "stream": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "type": "string"
        },
        "cross_sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "layer",
              "field",
              "elevation_ft",
              "distance_m",
              "v_datum",
              "len_unit"
            ],
            "properties": {
              "layer": {
                "type": "string"
              },
              "field": {
                "type": "string",
                "enum": [
                  "WSEL_REG",
                  "ELEV"
                ]
              },
              "elevation_ft": {
                "type": "number"
              },
              "stream": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "stream_station": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "distance_m": {
                "type": "number"
              },
              "v_datum": {
                "type": "string"
              },
              "len_unit": {
                "type": "string"
              }
            }
          }
        },
        "bfe_line_check": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "layer",
                "field",
                "elevation_ft",
                "distance_m",
                "v_datum",
                "len_unit"
              ],
              "properties": {
                "layer": {
                  "type": "string"
                },
                "field": {
                  "type": "string",
                  "enum": [
                    "WSEL_REG",
                    "ELEV"
                  ]
                },
                "elevation_ft": {
                  "type": "number"
                },
                "stream": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "stream_station": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "distance_m": {
                  "type": "number"
                },
                "v_datum": {
                  "type": "string"
                },
                "len_unit": {
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "nearest_distance_m": {
          "type": "number"
        },
        "v_datum": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "len_unit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "search_radius_m": {
          "type": "number"
        },
        "source": {
          "type": "string"
        },
        "relative_to_floor_ft": {
          "type": "number",
          "description": "FEMA level minus floor (central): > 0 is depth inside, < 0 stays below the floor."
        },
        "relative_to_floor_ft_low": {
          "type": "number"
        },
        "relative_to_floor_ft_high": {
          "type": "number"
        },
        "sentence": {
          "type": "string"
        }
      }
    },
    "reference_levels": {
      "type": "array",
      "description": "Marks for the depth gauge. depth_above_floor_ft < 0 means the level stays below the floor by that much.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "elevation_ft",
          "elevation_ft_low",
          "elevation_ft_high",
          "depth_above_floor_ft",
          "depth_above_floor_ft_low",
          "depth_above_floor_ft_high",
          "source",
          "sentence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "fema-1pct",
              "lowest-door-ground",
              "lowest-adjacent-ground"
            ]
          },
          "label": {
            "type": "string"
          },
          "elevation_ft": {
            "type": "number"
          },
          "elevation_ft_low": {
            "type": "number"
          },
          "elevation_ft_high": {
            "type": "number"
          },
          "depth_above_floor_ft": {
            "type": "number"
          },
          "depth_above_floor_ft_low": {
            "type": "number"
          },
          "depth_above_floor_ft_high": {
            "type": "number"
          },
          "source": {
            "type": "string"
          },
          "sentence": {
            "type": "string"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "description": "One per slider step (0 to 8 ft by 0.25 ft, the same steps as ScenarioTable): the outside water-surface elevation that corresponds to that interior depth.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "depth_ft",
          "water_surface_ft",
          "water_surface_ft_low",
          "water_surface_ft_high"
        ],
        "properties": {
          "depth_ft": {
            "type": "number",
            "minimum": 0,
            "maximum": 8
          },
          "water_surface_ft": {
            "type": "number"
          },
          "water_surface_ft_low": {
            "type": "number"
          },
          "water_surface_ft_high": {
            "type": "number"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    }
  },
  "$defs": {
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "source",
        "placeholder"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "placeholder": {
          "type": "boolean",
          "description": "true = team-set assumption: badge it 'assumed range, editable'."
        }
      }
    }
  }
}
